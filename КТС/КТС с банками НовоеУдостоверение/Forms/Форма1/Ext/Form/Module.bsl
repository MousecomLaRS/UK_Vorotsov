&НаСервере
Процедура ПечатьЗаявленияНаОтзывНаСервере(ТабДок)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ТекОбъект.ПолучитьМакет("ЗаявлениеОбОтзыве");
	МакетДов = ТекОбъект.ПолучитьМакет("Доверенность");
	Для шаг = 0 По ЭтаФорма.Сотрудники.Количество()-1 Цикл
		Стр = ЭтаФорма.Сотрудники.Получить(шаг);
		ФЛ = Стр.Сотрудник.ФизическоеЛицо;
		Если Стр.ОтметкаСотрудник или Стр.ОтметкаПодразделение или Стр.ОтметкаВсе Тогда
			Ошапка = Макет.ПолучитьОбласть("Заявление");
			//Ошапка.Параметры.ДатаРешения = Формат(ЭтаФорма.РешениеДата,"ДЛФ=Д");
			Ошапка.Параметры.Сотрудник = Стр.Сотрудник;
			Ошапка.Параметры.ИНН = ФЛ.ИНН;
			ФЛ = Стр.Сотрудник.ФизическоеЛицо;
			Пол = 1;
			Если ФЛ.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				Пол = 2;
			КонецЕсли;	
			ФИОПолноеРодПадеж = СклонениеПредставленийОбъектов.ПросклонятьФИО(Стр.Сотрудник.Наименование, 2, Стр.Сотрудник, Пол);
			Ошапка.Параметры.Сотрудника = ФИОПолноеРодПадеж;
			Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФЛ, Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица);
			Адрес = СтрЗаменить(Адрес,"РОССИЯ,","");
			Адрес = СтрЗаменить(Адрес,"Воркутинский р-н,","");
			Ошапка.Параметры.Адрес = Адрес;
			Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФЛ, Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
			Ошапка.Параметры.Телефон = Телефон;
			ЭлПочта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФЛ, Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
			Ошапка.Параметры.ЭлПочта = ЭлПочта;
			ДанныеФизЛица = КадровыйУчет.ДокументыФизическихЛиц(ФЛ, Истина); 
			Серия = ДанныеФизЛица[0].Серия;	
			Номер = ДанныеФизЛица[0].Номер;	
			Выдан = ДанныеФизЛица[0].КемВыдан;	
			ДатаВыдачи = ДанныеФизЛица[0].ДатаВыдачи;	
			ПредставлениеДокумента = "Серия "+Серия+" № "+Номер;
			ПредставлениеДокументаВыдан = "выдан "+Выдан+" "+Формат(ДатаВыдачи,"ДЛФ=Д")+" г.";
			Ошапка.Параметры.ПредставлениеДокумента = ПредставлениеДокумента;
			Ошапка.Параметры.ПредставлениеДокументаВыдан = ПредставлениеДокументаВыдан;
			Ошапка.Параметры.НомерУдостоверения = Стр.НомерУдостоверения;
			Ошапка.Параметры.ДатаВыдачиУдостоверения = Формат(ЭтаФорма.УдостоверениеДата,"ДЛФ=Д")+" г.";
			Ошапка.Параметры.Организация = Справочники.Организации.ОрганизацияПоУмолчанию().НаименованиеПолное;
			Ошапка.Параметры.НомерРешения = ЭтаФорма.РешениеНомер;
			Ошапка.Параметры.ДатаРешения = Формат(ЭтаФорма.РешениеДата,"ДЛФ=Д")+" г.";
			
			ТабДок.Вывести(Ошапка);
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();			
			Если Стр.СДоверенностью Тогда
				ИННорг = Справочники.Организации.ОрганизацияПоУмолчанию().ИНН;
				ОГРНорг = Справочники.Организации.ОрганизацияПоУмолчанию().ОГРН;
				ОДов = МакетДов.ПолучитьОбласть("Доверенность");
				ОДов.Параметры.Сотрудник = Стр.Сотрудник;
				Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФЛ, Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица);
				Адрес = СтрЗаменить(Адрес,"РОССИЯ,","");
				Адрес = СтрЗаменить(Адрес,"Воркутинский р-н,","");
				ОДов.Параметры.Адрес = Адрес;
				ОДов.Параметры.НомерРешения = ЭтаФорма.РешениеНомер;
				ОДов.Параметры.ИННОрг = ИННОрг;
				ОДов.Параметры.ОГРНОрг = ОГРНОрг;
				ОДов.Параметры.ДатаРешения = Формат(ЭтаФорма.РешениеДата,"ДЛФ=Д")+" г.";
				ОДов.Параметры.НомерУдостоверения = Стр.НомерУдостоверения;
				ОДов.Параметры.ДатаВыдачиУдостоверения = Формат(ЭтаФорма.УдостоверениеДата,"ДЛФ=Д")+" г.";
				ОДов.Параметры.Организация = Справочники.Организации.ОрганизацияПоУмолчанию().НаименованиеПолное;
				ОДов.Параметры.ПредставлениеДокумента = ПредставлениеДокумента;
				ОДов.Параметры.ПредставлениеДокументаВыдан = ПредставлениеДокументаВыдан;
				ОДов.Параметры.ДатаДействия = Формат(Стр.ОкончаниеСрокаДоверенности,"ДЛФ=Д")+" г.";
                ОДов.Параметры.ДатаДоверенности = Формат(ТекущаяДата(),"ДЛФ=Д")+" г.";
				ТабДок.Вывести(ОДов);
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();			
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗаявленияНаОтзыв(Команда)
	ТабДок = новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	ПечатьЗаявленияНаОтзывНаСервере(ТабДок);
	ИдентификаторПечатнойФормы = "ЗаявлениеОбОтзыве";
	НазваниеПечатнойФормы = НСтр("ru = 'ЗаявлениеОбОтзыве'");
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		ТабДок.Показать(НазваниеПечатнойФормы);
		Возврат;
	КонецЕсли;
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");     
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = ТабДок;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
