&НаСервере
Процедура ВыбратьВедомостиНаСервере()
	// Вставить содержимое обработчика.
	ЭтаФорма.Сотрудники.Очистить();
	ЭтаФорма.Ведомости.Очистить();
	Вед = Документы.ВедомостьНаВыплатуЗарплатыВБанк.Выбрать(НачалоДня(ЭтаФорма.ПериодС),КонецДня(ЭтаФорма.ПериодПо));
	Пока Вед.Следующий() Цикл
		Стр = ЭтаФорма.Ведомости.Добавить();
		Стр.Отметка = Ложь;
		Стр.Ведомость = Вед.Ссылка;
		Стр.СпособВыплаты = Вед.СпособВыплаты.Ссылка;
		СуммаПоВед = 0;
		Для шаг = 0 По Вед.Зарплата.Количество()-1 Цикл
			СтрСумм = Вед.Зарплата.Получить(шаг);
			СуммаПоВед = СуммаПоВед + СтрСумм.КВыплате;
		КонецЦикла;	
		Стр.Сумма = СуммаПоВед;
	КонецЦикла;	
КонецПроцедуры

