	ЭтаФорма.Отпуск = ЭтаФорма.Сотрудники.Итог("СуммаОтпуск");
	ЭтаФорма.Всего = ЭтаФорма.Сотрудники.Итог("СуммаЗарплата") + ЭтаФорма.Сотрудники.Итог("СуммаОтпуск");
