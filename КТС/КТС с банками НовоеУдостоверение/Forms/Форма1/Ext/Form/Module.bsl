&НаКлиенте
Перем RegExp;

&НаСервере
Функция ПодчеркнутьТекстВМакете(Строка)  
	Результат = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если Сред(Строка, Индекс, 1) <> " " И Сред(Строка, Индекс, 1) <> "_" И Сред(Строка, Индекс, 1) <> "-" Тогда 
			Результат = Результат + Символ(863);
		КонецЕсли;
		Результат = Результат + Сред(Строка, Индекс, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьАдресОрганизации()
	Со = новый СообщениеПользователю;
	Адрес = "";
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|ОрганизацииКонтактнаяИнформация.Ссылка КАК Ссылка,
	|ОрганизацииКонтактнаяИнформация.Тип КАК Тип,
	|ОрганизацииКонтактнаяИнформация.Вид КАК Вид,
	|ОрганизацииКонтактнаяИнформация.Представление КАК Представление
	|ИЗ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	|ГДЕ ОрганизацииКонтактнаяИнформация.Ссылка = &Ссылка
	|И ОрганизацииКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|И ОрганизацииКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации)";
	Запрос.УстановитьПараметр("Ссылка",Справочники.Организации.ОрганизацияПоУмолчанию());
	ВыбЗапрос = Запрос.Выполнить().Выбрать();
	Если ВыбЗапрос.Следующий() Тогда
		Адрес = ВыбЗапрос.Представление;
	КонецЕсли;	
	Возврат Адрес;
КонецФункции	
&НаСервере
Процедура ПериодВыплаты(СтрСотр,МесЗарп,МесяцЗарплаты,ГодЗарплаты)
	МесЗарп = Месяц(СтрСотр.ПериодВыплаты);
	ГодЗарплаты = Год(СтрСотр.ПериодВыплаты);
	Если МесЗарп = 1 Тогда
		МесяцЗарплаты = "января";
	ИначеЕсли МесЗарп = 2 Тогда
		МесяцЗарплаты = "февраля";
	ИначеЕсли МесЗарп = 3 Тогда
		МесяцЗарплаты = "марта";
	ИначеЕсли МесЗарп = 4 Тогда
		МесяцЗарплаты = "апреля";
	ИначеЕсли МесЗарп = 5 Тогда
		МесяцЗарплаты = "мая";
	ИначеЕсли МесЗарп = 6 Тогда
		МесяцЗарплаты = "июня";
	ИначеЕсли МесЗарп = 7 Тогда
		МесяцЗарплаты = "июля";
	ИначеЕсли МесЗарп = 8 Тогда
		МесяцЗарплаты = "августа";
	ИначеЕсли МесЗарп = 9 Тогда
		МесяцЗарплаты = "сентября";
	ИначеЕсли МесЗарп = 10 Тогда
		МесяцЗарплаты = "октября";
	ИначеЕсли МесЗарп = 11 Тогда
		МесяцЗарплаты = "ноября";
	Иначе
		МесяцЗарплаты = "декабря";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура Прием(Сотр,ДатаПриема,ДоговорОт,ДоговорНомер,ДатаРождения)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПриемНаРаботу.Сотрудник.Ссылка КАК СотрудникСсылка,
	|	ПриемНаРаботу.ДатаПриема КАК ДатаПриема,
	|	ПриемНаРаботу.ФизическоеЛицо.Ссылка КАК ФизическоеЛицоСсылка,
	|	ПриемНаРаботу.ФизическоеЛицо.Наименование КАК ФизическоеЛицоНаименование,
	|	ПриемНаРаботу.Сотрудник.Наименование КАК СотрудникНаименование,
	|	ПриемНаРаботу.ФизическоеЛицо.ДатаРождения КАК ФизическоеЛицоДатаРождения,
	|	ПриемНаРаботу.Дата КАК Дата,
	|	ПриемНаРаботу.ТрудовойДоговорНомер КАК ТрудовойДоговорНомер,
	|	ПриемНаРаботу.ТрудовойДоговорДата КАК ТрудовойДоговорДата
	|ИЗ
	|	Документ.ПриемНаРаботу КАК ПриемНаРаботу
	|ГДЕ
	|	ПриемНаРаботу.Проведен = ИСТИНА
	|	И ПриемНаРаботу.Сотрудник.Ссылка = &Сотр
	|
	|УПОРЯДОЧИТЬ ПО
	|	СотрудникНаименование";
	Запрос.УстановитьПараметр("Сотр",Сотр);
	ВыбЗапрос = Запрос.Выполнить().Выбрать();
	Пока ВыбЗапрос.Следующий() Цикл
		ДатаПриема = ВыбЗапрос.ДатаПриема;
		ДоговорОт = ВыбЗапрос.ТрудовойДоговорДата;
		ДоговорНомер = ВыбЗапрос.ТрудовойДоговорНомер;
		ДатаРождения = ВыбЗапрос.ФизическоеЛицоДатаРождения;
	КонецЦикла;
КонецПроцедуры

