&НаКлиенте
Процедура СотрудникиОтметкаПодразделениеПриИзменении(Элемент)
	// Вставить содержимое обработчика.
	инд = ЭтаФорма.Сотрудники.Индекс(ЭтаФорма.Элементы.Сотрудники.ТекущиеДанные);
	СтрСотр = ЭтаФорма.Сотрудники.Получить(инд);
	Подр = СтрСотр.Подразделение;
	Если СтрСотр.ОтметкаПодразделение Тогда
		Для шаг = 0 По ЭтаФорма.Сотрудники.Количество()-1 Цикл
			Стр = ЭтаФорма.Сотрудники.Получить(шаг);
			Если шаг <> инд Тогда
				Если Стр.Подразделение = Подр Тогда
					Стр.ОтметкаПодразделение = Истина;
				Иначе
					Стр.ОтметкаПодразделение = Ложь;
				КонецЕсли;	
			КонецЕсли;
			Стр.ОтметкаСотрудник = Ложь;
			Стр.ОтметкаВсе = Ложь;
		КонецЦикла;
	Иначе	
		Для шаг = 0 По ЭтаФорма.Сотрудники.Количество()-1 Цикл
			Стр = ЭтаФорма.Сотрудники.Получить(шаг);
			Стр.ОтметкаПодразделение = Ложь;
			Стр.ОтметкаСотрудник = Ложь;
			Стр.ОтметкаВсе = Ложь;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

