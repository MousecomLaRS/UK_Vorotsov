&НаСервере
Функция ПолучитьДолжностьСотрудника(Сот)
	Со = Новый СообщениеПользователю;
	ЗапросПоСотрудникам = Новый Запрос;
	ЗапросПоСотрудникам.Текст = "ВЫБРАТЬ
	|	КадроваяИсторияСотрудников.Должность.Ссылка КАК ДолжностьСсылка,
	|	КадроваяИсторияСотрудников.Сотрудник.Ссылка КАК СотрудникСсылка,
	|	КадроваяИсторияСотрудников.Должность.Наименование КАК ДолжностьНаименование,
	|	КадроваяИсторияСотрудников.Период КАК Период
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КадроваяИсторияСотрудников
	|ГДЕ
	|	КадроваяИсторияСотрудников.Сотрудник.Ссылка = &Сотр
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	ЗапросПоСотрудникам.Параметры.Вставить("Сотр", Сот);
	ВыбЗапрос = ЗапросПоСотрудникам.Выполнить().Выбрать();
	Должность = "";
	//Со.Текст = Строка(ВыбЗапрос.Количество());
	//Со.Сообщить();
	Если ВыбЗапрос.Следующий() Тогда
		Должность = Сред(ВыбЗапрос.ДолжностьНаименование,1,140);
	КонецЕсли;
	Возврат Должность;
	
КонецФункции

&НаСервере
Функция ПолучитьПаспортСотрудника(Сот)
	Со = Новый СообщениеПользователю;
	ЗапросПоСотрудникам = Новый Запрос;
	ЗапросПоСотрудникам.Текст = "ВЫБРАТЬ
	                            |	ДокументыФизическихЛицСрезПоследних.Серия + "" "" + ДокументыФизическихЛицСрезПоследних.Номер КАК Паспорт
	                            |ИЗ
	                            |	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК ДокументыФизическихЛицСрезПоследних
	                            |ГДЕ
	                            |	ДокументыФизическихЛицСрезПоследних.Физлицо = &Физлицо";
	ЗапросПоСотрудникам.Параметры.Вставить("Физлицо", Сот.ФизическоеЛицо);
	ВыбЗапрос = ЗапросПоСотрудникам.Выполнить().Выбрать();
	Должность = "";
	//Со.Текст = Строка(ВыбЗапрос.Количество());
	//Со.Сообщить();
	Если ВыбЗапрос.Следующий() Тогда
		Паспорт = ВыбЗапрос.Паспорт;
	КонецЕсли;
	Возврат Паспорт;
	
КонецФункции


&НаСервере
Процедура ВедомостиОтметкаПриИзмененииНаСервере(инд)
	// Вставить содержимое обработчика.
	//Со = новый СообщениеПользователю;
	//Со.Текст = ЭтаФорма.Элементы.Ведомости.ТекущиеДанные;
	//Со.Сообщить();
	//Возврат;
	СтрВед = ЭтаФорма.Ведомости.Получить(инд);
	Для шаг = 0 По СтрВед.Ведомость.Зарплата.Количество()-1 Цикл
		Стр = СтрВед.Ведомость.Зарплата.Получить(шаг);
		//Док = Документы.ВедомостьНаВыплатуЗарплатыВБанк.СоздатьДокумент();
		//Док.Состав.Найти(Стр.ИдентификаторСтроки);
		СтрСостав = СтрВед.Ведомость.Состав.Найти(Стр.ИдентификаторСтроки);
		Подразделение = "";
		Подразделение1 = "";
		КадровыеДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(Истина, Стр.Сотрудник, "Подразделение", ТекущаяДата());
		Если КадровыеДанныеСотрудника.Количество() > 0 Тогда
			ТекущиеКадровыеДанныеСотрудника = КадровыеДанныеСотрудника[0];
			Подразделение = СокрЛП(ТекущиеКадровыеДанныеСотрудника.Подразделение);
			Подразделение = СтрЗаменить(Подразделение,"(рабочие)","") ;
			Подразделение = СокрЛП(СтрЗаменить(Подразделение,"(ИТР)","")) ;
		КонецЕсли;
		Должность = СокрЛП(ПолучитьДолжностьСотрудника(Стр.Сотрудник));
		Паспорт = СокрЛП(ПолучитьПаспортСотрудника(Стр.Сотрудник));
		НомУд =  СокрЛП(СтрВед.Ведомость.Номер) + "_" + Строка(шаг+1);
		СпособВыплаты = СтрВед.СпособВыплаты.Наименование;
		Найден = ложь;
		Для шаг1 = 0 По ЭтаФорма.Сотрудники.Количество()-1 Цикл
			Стр1 = ЭтаФорма.Сотрудники.Получить(шаг1);
			Если Стр.Сотрудник = Стр1.Сотрудник и Должность = СокрЛП(Стр1.Должность) и Подразделение = СокрЛП(Стр1.Подразделение) Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если не найден Тогда
			Если СтрВед.Отметка = Истина Тогда
				Если Стр.КВыплате <> 0 Тогда
					Стр1 = ЭтаФорма.Сотрудники.Добавить();
					Стр1.ПорПеч = 888;
					Стр1.СуммаОтпуск = 0;
					Стр1.СуммаЗарплата = 0;
					Стр1.Сотрудник = Стр.Сотрудник;
					Стр1.Должность = Должность;
					Стр1.Паспорт = Паспорт;
					Стр1.Подразделение = Подразделение;
					Стр1.НомерУдостоверения = Стр.Сотрудник.Код;
					Стр1.СпособВыплаты = СтрВед.Ведомость.СпособВыплаты;
					Если ТипЗнч(Стр.ДокументОснование) = Тип("ДокументСсылка.Отпуск") или ТипЗнч(Стр.ДокументОснование) = Тип("ДокументСсылка.Увольнение") Тогда
						Стр1.ДокументОснование = Стр.ДокументОснование;
					КонецЕсли;	
					Если СпособВыплаты = "Отпуска" Тогда
						Стр1.СуммаОтпуск = Стр1.СуммаОтпуск + Стр.КВыплате;
					Иначе
						Стр1.СуммаЗарплата = Стр1.СуммаЗарплата + Стр.КВыплате;
						Если ЗначениеЗаполнено(Стр.ДокументОснование) Тогда
							Если ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.Отпуск") и ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.Увольнение") Тогда // и ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.БольничныйЛист")
								Стр1.ПериодВыплаты = Стр.ПериодВзаиморасчетов;
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;
					Стр1.Банк = ?(СтрСостав.БанковскийСчет.Банк = Справочники.КлассификаторБанков.ПустаяСсылка(), СтрВед.Ведомость.ЗарплатныйПроект.Банк, СтрСостав.БанковскийСчет.Банк);
					Стр1.ЛицевойСчет = Стр.НомерЛицевогоСчета;
				КонецЕсли;
			КонецЕсли		
		Иначе	
			Если СтрВед.Отметка = Ложь Тогда
				Если СпособВыплаты = "Отпуска" Тогда
					Стр1.СуммаОтпуск = Стр1.СуммаОтпуск - Стр.КВыплате;
				Иначе
					Стр1.СуммаЗарплата = Стр1.СуммаЗарплата - Стр.КВыплате;
				КонецЕсли;
				Если Стр1.СуммаОтпуск + Стр1.СуммаЗарплата = 0 Тогда
					ЭтаФорма.Сотрудники.Удалить(шаг1);
				КонецЕсли;
			Иначе	
				Если ТипЗнч(Стр.ДокументОснование) = Тип("ДокументСсылка.Отпуск") или ТипЗнч(Стр.ДокументОснование) = Тип("ДокументСсылка.Увольнение") Тогда
					Стр1.ДокументОснование = Стр.ДокументОснование;
				КонецЕсли;	
				Если СпособВыплаты = "Отпуска" Тогда
					Стр1.СуммаОтпуск = Стр1.СуммаОтпуск + Стр.КВыплате;
				Иначе
					Стр1.СуммаЗарплата = Стр1.СуммаЗарплата + Стр.КВыплате;
					Стр1.СпособВыплаты = СтрВед.Ведомость.СпособВыплаты;
					Если ЗначениеЗаполнено(Стр.ДокументОснование) Тогда
						Если ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.Отпуск") и ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.Увольнение") Тогда  //и ТипЗНЧ(Стр.ДокументОснование) <> Тип("ДокументСсылка.БольничныйЛист")
							Стр1.ПериодВыплаты = Стр.ПериодВзаиморасчетов;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	ЭтаФорма.Сотрудники.Сортировать("Подразделение,Сотрудник,Должность");
	ЭтаФорма.Зарплата = ЭтаФорма.Сотрудники.Итог("СуммаЗарплата");
	ЭтаФорма.Отпуск = ЭтаФорма.Сотрудники.Итог("СуммаОтпуск");
	ЭтаФорма.Всего = ЭтаФорма.Сотрудники.Итог("СуммаЗарплата") + ЭтаФорма.Сотрудники.Итог("СуммаОтпуск");
КонецПроцедуры

