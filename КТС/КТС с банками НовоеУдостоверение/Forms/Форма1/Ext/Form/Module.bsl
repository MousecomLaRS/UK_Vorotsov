&НаСервере
Процедура ПечатьРеестраНаСервере(ТабДок)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ТекОбъект.ПолучитьМакет("Реестр");
	Ошапка = Макет.ПолучитьОбласть("шапка");
	Острока = Макет.ПолучитьОбласть("строка");
	Оподвал = Макет.ПолучитьОбласть("подвал");
	Ошапка.Параметры.Орг = Справочники.Организации.ОрганизацияПоУмолчанию().НаименованиеПолное;
	Ошапка.Параметры.Решение = "Решение № " + ЭтаФорма.РешениеНомер + " от " +Формат(ЭтаФорма.РешениеДата,"ДЛФ=Д") + ".";
	ТабДок.Вывести(Ошапка);
	Если ЭтаФорма.СписокПоУбыванию Тогда
		ЭтаФорма.Сотрудники.Сортировать("ПорПеч,Сотрудник УБЫВ,Должность");
	Иначе	
		ЭтаФорма.Сотрудники.Сортировать("ПорПеч,Сотрудник,Должность");
	КонецЕсли;	
	Нпп = 0;
	Для шаг = 0 По ЭтаФорма.Сотрудники.Количество()-1 Цикл
		Стр = ЭтаФорма.Сотрудники.Получить(шаг);
		Нпп = Нпп + 1;
		Острока.Параметры.УКТС = Стр.НомерУдостоверения;
		Острока.Параметры.ФИО = Стр.Сотрудник.Наименование;
		Острока.Параметры.СчетПолучателя = Стр.ЛицевойСчет;
		Острока.Параметры.БикБанка = Стр.Банк.Код;
		Острока.Параметры.Всего = Стр.СуммаЗарплата + Стр.СуммаОтпуск;
		ТабДок.Вывести(ОСтрока);
	КонецЦикла;	
	Оподвал.Параметры.ВсегоИтог = ЭтаФорма.Сотрудники.Итог("СуммаЗарплата")+ЭтаФорма.Сотрудники.Итог("СуммаОтпуск");
	ЭтаФорма.Сотрудники.Сортировать("Подразделение,Сотрудник,Должность");
	ТабДок.Вывести(ОПодвал);
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)
	ТабДок = новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	ПечатьРеестраНаСервере(ТабДок);
	ИдентификаторПечатнойФормы = "РеестрКТС";
	НазваниеПечатнойФормы = НСтр("ru = 'РеестрКТС'");
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		ТабДок.Показать(НазваниеПечатнойФормы);
		Возврат;
	КонецЕсли;
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");     
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = ТабДок;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
КонецПроцедуры

