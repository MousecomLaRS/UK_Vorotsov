&НаКлиенте
Процедура ОтпускПриИзменении(Элемент)
	Перем Matches;
	Перем Match;
	Перем Submatches;
	Перем Submatch;
	Перем Сч;
	
	RegExp.Pattern = "<otpusk>(.|\n)*?<\/otpusk>"; // ищем текст об отпуске
	Если НЕ Отпуск Тогда
		// вырезаем кусок текста про отпуск
		// сохраняем
		Matches = RegExp.Execute(ПолеХТМЛ);
		Match = Matches.Item(0);
        Объект.ОтпускКусок = Match.Value;
		// вырезаем
		ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<otpusk></otpusk>");
	Иначе
		//вставляем кусок текста про отпуск
		ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, Объект.ОтпускКусок);
		Объект.ОтпускКусок = "";
	КонецЕсли;

КонецПроцедуры


