&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОткрытьШаблон("ЗаявлениеКТС");
	RegExp = Новый COMОбъект("VBScript.RegExp"); // создаем объект для работы с регулярными выражениями
	RegExp.MultiLine = Истина;  // истина — текст многострочный, ложь — одна строка
	RegExp.Global = Истина;     // истина — поиск по всей строке, ложь — до первого совпадения
	RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	
	Отпуск = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаявлениеКТС(Команда)
	RegExp.Pattern = "<dolzhnost>(.|\n)*?<\/dolzhnost>"; // должность
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<dolzhnost>"+Объект.Должность+"</dolzhnost>");
	
	RegExp.Pattern = "<uchastok>(.|\n)*?<\/uchastok>"; // участок
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<uchastok>"+Объект.Участок+" </uchastok>");
	
	RegExp.Pattern = "<fio>(.|\n)*?<\/fio>"; // ФИО
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<fio>"+Объект.ФИО+"</fio>");
	
	RegExp.Pattern = "<data_priema>(.|\n)*?<\/data_priema>"; // дата приёма
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<data_priema>"+Формат(Объект.ДатаПриёма, "ДЛФ=Д")+"</data_priema>");
	
	RegExp.Pattern = "<data_dogovora>(.|\n)*?<\/data_dogovora>"; // дата договора
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<data_dogovora>"+Формат(Объект.ДатаДоговора, "ДЛФ=Д")+"</data_dogovora>");
	
	RegExp.Pattern = "<nomer_dogovora>(.|\n)*?<\/nomer_dogovora>"; // номер договора
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<nomer_dogovora>"+Объект.НомерДоговора+"</nomer_dogovora>");
	
	
КонецПроцедуры


&НаКлиенте
Процедура СформироватьУдостоверение(Команда)
	RegExp.Pattern = "<nomer_ud>(.|\n)*?<\/nomer_ud>"; // номер удостоверения
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<nomer_ud>"+Формат(Объект.НомерУдостоверения, "ЧЦ=1")+"</nomer_ud>");
	
	RegExp.Pattern = "<data_ud>(.|\n)*?<\/data_ud>"; // дата удостоверения
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<data_ud>"+Формат(Объект.ДатаУдостоверения, "ДЛФ=Д")+" г.</data_ud>");
	
	RegExp.Pattern = "<nomer_resh>(.|\n)*?<\/nomer_resh>"; // номер решения
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<nomer_resh>"+Формат(Объект.НомерРешения, "ЧЦ=1")+"</nomer_resh>");
	
	RegExp.Pattern = "<data_resh>(.|\n)*?<\/data_resh>"; // дата решения
	ПолеХТМЛ = RegExp.Replace(ПолеХТМЛ, "<data_resh>"+Формат(Объект.ДатаРешения, "ДЛФ=ДД")+"</data_resh>");
	

КонецПроцедуры


